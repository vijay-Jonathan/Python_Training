{
	auto_https off
	admin off
	persist_config off
}

:8080 {
	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}
	handle {
		root * /srv
		encode gzip
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@selectedImages {
			path_regexp selectedImages ^/images/selected/[a-f0-9]{64}(-w640v1)?\.jpg$
			file {path}
		}
		header @selectedImages Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
